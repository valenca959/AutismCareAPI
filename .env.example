# Copie para .env (na raiz do repositório) e preencha os valores.
#   cp .env.example .env

# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Obrigatória. Chave Fernet que criptografa CPF e notas médicas. NÃO PERCA esta chave.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_FIELD_ENCRYPTION_KEY=

# True só em desenvolvimento.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcionais
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=nao-responder@autismcare.local
# FRONTEND_URL=http://localhost:3000
